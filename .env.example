# Understudy: every environment variable the app, the scripts and the tests read.
# Copy to .env.local and fill the two keys. No secret belongs in this file.

# --- Required -------------------------------------------------------------------------------

# Postgres. The default is the Docker database started by `pnpm db:up` (docker-compose.yml).
# In production: a Supabase pooler connection string.
DATABASE_URL=postgres://postgres:postgres@localhost:45432/understudy

# 32 random bytes each, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# IDENTITY_KEY keys the HMAC of e-mail addresses; CONTACTS_KEY encrypts the contact details.
IDENTITY_KEY=
CONTACTS_KEY=

# --- Model (any OpenAI-compatible chat endpoint) --------------------------------------------

# The committed demo answers replay only for the model that made them (the cache key holds the
# model name and host). These two values are the hosted demo's; cached prompts need no key.
MODEL_BASE_URL=https://openrouter.ai/api/v1
MODEL_NAME=qwen/qwen3-32b
# Needed only for prompts that are not in the cache (uploads, new answers).
MODEL_API_KEY=
# Fully local instead (no source text leaves the machine): ollama pull qwen3:8b, then
#   MODEL_BASE_URL=http://localhost:11434/v1   MODEL_NAME=qwen3:8b   MODEL_API_KEY=ollama

# --- Optional -------------------------------------------------------------------------------

# Raises the GitHub API rate limit for public repo imports.
GITHUB_TOKEN=

# Protects GET /api/cron/purge (the daily cleanup in vercel.json). Without it the route answers 401.
CRON_SECRET=
# Retention of the cleanup, in days: demo copies, and workspaces that started empty and went idle.
# A workspace with an approved snapshot is never deleted.
#PURGE_DEMO_DAYS=7
#PURGE_IDLE_DAYS=14

# Caps on live model calls per day (0 turns a cap off). Cached answers never count.
#MODEL_CALLS_PER_WORKSPACE_PER_DAY=400
#MODEL_CALLS_PER_DAY=4000

# How long one function invocation works on a pipeline run before it pauses and continues in
# the next one, in milliseconds. The default is shown.
#RUN_SLICE_BUDGET_MS=150000

# Extraction prompt (r2 = the default, v2 = two-pass candidates); ATTEST_CONSOLIDATE=0 turns the
# code-only consolidation pass off. Leave unset to use the pack's setting.
#ATTEST_PROMPT=r2
#ATTEST_CONSOLIDATE=1

# Stand-in successor: unset = the model when reachable, "cache" = cached answers only,
# "off" = the rule-based reading only.
#LACUNA_MODEL=

# 1 = never touch the network for model calls: answer from the cache or fail fast (vitest sets this).
#MODEL_DISABLED=

# --- Tests and scripts ----------------------------------------------------------------------

# Playwright target (default http://localhost:3000).
#E2E_BASE_URL=
# A transaction-pooler URL: also runs the cold-pool regression test through it (tests/db/pool.test.ts).
#POOLER_TEST_URL=
# The staging database's pooler URL, for `pnpm staging:setup`.
#STAGING_POOLER_URL=
# 1 = keep the workspaces the integration tests create (for debugging).
#LACUNA_KEEP_WS=
#LIVING_KEEP_WS=
# 1 = rewrite the golden hashes: UPDATE_GOLDEN=1 pnpm vitest run tests/pack/golden.test.ts
#UPDATE_GOLDEN=
